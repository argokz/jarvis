# --- Claude ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_EFFORT=medium
JARVIS_MAX_BUDGET_USD=1.0      # потолок расходов на один ход

# --- Хранилище ---
JARVIS_VAULT=./vault           # путь к Obsidian-vault (создастся, если нет)
JARVIS_DB=./data/jarvis.db

# --- Клиенты ---
JARVIS_API_TOKEN=              # openssl rand -hex 32; пусто = HTTP API выключен
TELEGRAM_BOT_TOKEN=            # от @BotFather; пусто = бот выключен
TELEGRAM_ALLOWED_IDS=          # ваш числовой Telegram ID (через запятую)

# --- Интеграции (необязательно) ---
GITHUB_TOKEN=                  # fine-grained PAT, read-only
YANDEX_SPEECHKIT_API_KEY=      # API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_SPEECHKIT_LANG=ru-RU    # или kk-KZ
YANDEX_SPEECHKIT_VOICE=alena   # голос синтеза
YANDEX_SPEECHKIT_TTS_RATE=48000
YANDEX_FOLDER_ID=              # нужен только для авторизации не через API-ключ сервисного аккаунта

# --- Умный дом и Notion (необязательно) ---
HASS_URL=                      # адрес Home Assistant, напр. http://127.0.0.1:8123
HASS_TOKEN=                    # долгосрочный токен: профиль HA → Безопасность → Long-lived access tokens
JARVIS_CALENDAR=1              # календари HA (Google Calendar — интеграцией HA); 0 — выключить
JARVIS_CALENDAR_DEFAULT=       # название календаря для новых событий (пусто — первый, куда можно писать)
HASS_MCP_PATH=/api/mcp/assist  # только открытые ассистентам устройства; /api/mcp — все API Home Assistant
NOTION_TOKEN=                  # токен внутренней интеграции: notion.so/profile/integrations
NOTION_PARENT_PAGE=            # ссылка или id страницы, под которой ассистент создаёт новые

# --- Речь на своих серверах (вместо SpeechKit, если задан хотя бы один URL) ---
JARVIS_STT_URL=   # свой сервер (python -m jarvis.stt_server): http://127.0.0.1:5006/v1/audio/transcriptions
                  # либо любой OpenAI-совместимый: faster-whisper-server, speaches
JARVIS_STT_MODEL= # только для Whisper-серверов, напр. Systran/faster-whisper-small
JARVIS_STT_ENGINE=gigaam-v3-e2e-ctc   # модель сервера jarvis.stt_server (onnx-asr)
JARVIS_WAKE_WORDS=джарвис             # слова активации через запятую, первое — имя ассистента; только со своим STT
# Синтез: адрес на /audio/speech — OpenAI-совместимый сервер (свой: python -m jarvis.tts_server,
# http://127.0.0.1:5007/v1/audio/speech); иначе — HTTP-сервер Piper (http://127.0.0.1:5005)
JARVIS_TTS_URL=
JARVIS_TTS_VOICE=              # Silero: aidar, eugene, baya, kseniya, xenia; у клонирования — имя образца
JARVIS_TTS_MODEL=              # только чужим OpenAI-совместимым серверам, которым нужно поле model
JARVIS_TTS_RATE=22050          # частота звука сервера: Piper medium — 22050, Silero — 48000, клонирование — 24000
JARVIS_SPEECH_LANG=ru-RU

# --- Push на телефон через ntfy (этап 3) ---
NTFY_URL=                      # https://ntfy.sh или свой сервер ntfy
NTFY_TOPIC=                    # длинное случайное имя темы: openssl rand -hex 12
NTFY_TOKEN=                    # токен доступа, если тема закрыта (свой ntfy)
JARVIS_CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# --- Голос (этап 2) ---
JARVIS_ROUTER_MODEL=claude-haiku-5-5
JARVIS_ROUTER_EFFORT=low
JARVIS_ROUTER_CACHE_TTL=1h     # кэш подсказки и инструментов быстрой модели: 1h или 5m
JARVIS_END_SILENCE_MS=500      # клиент: тишина после команды (после сигнала «Джарвис»), мс
JARVIS_PHRASE_END_SILENCE_MS=600  # клиент: тишина после фразы «Джарвис, …», мс
JARVIS_VOICE_AGENT_TIMEOUT=25  # дольше — ответ придёт в Telegram
JARVIS_OPEN_ROOTS=             # папки для поиска/открытия файлов через «;», напр. D:/Documents;D:/projects
JARVIS_PC_CONTROL=             # 1 — громкость, плееры, музыка, открыть сайт и YouTube на ПК с ядром (Linux: wpctl, gdbus)
JARVIS_MEDIA_DUCK=0.3          # пока ассистент слушает и говорит, видео и плееры тише во столько раз; 0 — не трогать
JARVIS_SCREEN=                 # 1 — агент может сделать снимок экрана по просьбе («что у меня на экране?»)
JARVIS_PRINTER=                # принтер для печати файлов; пусто — системный по умолчанию
JARVIS_BROWSER=                # 1 — агент поручает задачи в интернете помощнику с браузером (нужен Playwright MCP, см. README)
JARVIS_BROWSER_MODEL=          # модель помощника с браузером; пусто — JARVIS_ROUTER_MODEL
JARVIS_BROWSER_HEADLESS=       # 1 — не показывать окно Chrome (поисковики тогда требуют проверку «я не робот»)
JARVIS_BROWSER_SEARCH=         # адрес поиска, к которому дописывается запрос; пусто — https://www.bing.com/search?q=
JARVIS_BROWSER_BUDGET_USD=0.3  # потолок расходов на одно поручение в браузере
JARVIS_SESSION_IDLE_MIN=30     # минут тишины, после которых агент начинает новую сессию (0 — никогда)
YANDEX_MUSIC_TOKEN=            # токен Яндекс Музыки (нужен Плюс); пусто — музыка на ПК только с YouTube
JARVIS_MUSIC_SOURCE=           # youtube | yandex; пусто — yandex, если задан токен, иначе youtube
JARVIS_STATION_ENTITY=         # плеер Яндекс Станции в Home Assistant; пусто — первый media_player.yandex_station_*

# --- Голосовой клиент на ПК ---
JARVIS_VOICE_URL=ws://127.0.0.1:8000/voice/ws
JARVIS_WAKE_MODE=phrase        # phrase — «Джарвис, …» по тексту; model — «Hey Jarvis» (openWakeWord); both
JARVIS_WAKE_THRESHOLD=0.5      # чувствительность «Hey Jarvis»
JARVIS_MIC_DEVICE=             # номер или часть имени микрофона (--list-devices); пусто — системный
JARVIS_BARGE_IN=wake           # wake — перебивать только «Hey Jarvis» (режимы model, both); vad — любой речью (гарнитура)
JARVIS_ALARM_SOUND=            # свой звук будильника: wav, mp3, ogg (нужен ffmpeg; без него — WAV); пусто — встроенный

# Надёжность
JARVIS_HOME_LIVE=1             # вкладка «Дом» получает изменения из Home Assistant сразу; 0 — только по кнопке «Обновить»
JARVIS_WATCH_MIN=5             # раз в столько минут опрашивать серверы речи и Home Assistant и сообщать о поломке; 0 — выключить
JARVIS_BACKUP_DIR=             # папка для резервных копий vault и базы (лучше на другом диске); пусто — не делать
JARVIS_BACKUP_KEEP=14          # сколько архивов хранить
JARVIS_BACKUP_HOURS=24         # раз во сколько часов делать копию
