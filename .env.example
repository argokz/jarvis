# --- Claude ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_EFFORT=medium
JARVIS_MAX_BUDGET_USD=1.0      # потолок расходов на один ход

# --- Хранилище ---
JARVIS_VAULT=./vault           # путь к Obsidian-vault (создастся, если нет)
JARVIS_DB=./data/jarvis.db

# --- Клиенты ---
JARVIS_API_TOKEN=              # openssl rand -hex 32; пусто = HTTP API выключен
TELEGRAM_BOT_TOKEN=            # от @BotFather; пусто = бот выключен
TELEGRAM_ALLOWED_IDS=          # ваш числовой Telegram ID (через запятую)

# --- Интеграции (необязательно) ---
GITHUB_TOKEN=                  # fine-grained PAT, read-only
YANDEX_SPEECHKIT_API_KEY=      # API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user
YANDEX_SPEECHKIT_LANG=ru-RU    # или kk-KZ
